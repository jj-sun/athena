<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.athena.modules.sys.mapper.SysRoleMapper">
	
	<!-- 查询用户创建的角色ID列表 -->
	<select id="queryRoleIdList" resultType="string">
		select id from sys_role where creator = #{createUserId}
	</select>
	<select id="findRoleCodeById" resultType="java.lang.String">

		SELECT role_code FROM sys_role WHERE id IN
		<foreach collection="ids" item="id" open="(" close=")" separator=",">
			#{id}
		</foreach>

	</select>
</mapper>